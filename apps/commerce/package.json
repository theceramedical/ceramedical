{
  "name": "@cera/commerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@cera/contracts": "workspace:*",
    "@cera/observability": "workspace:*",
    "@vendure/admin-ui-plugin": "3.7.3",
    "@vendure/asset-server-plugin": "3.7.3",
    "@vendure/core": "3.7.3",
    "dotenv": "17.2.3",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
