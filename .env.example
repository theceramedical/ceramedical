# Copy to .env for local-only development. Never commit .env.
COMPOSE_PROJECT_NAME=cera

# Local PostgreSQL only
POSTGRES_USER=cera_local
POSTGRES_PASSWORD=replace-local-password
POSTGRES_PORT=55432
CMS_DATABASE_URL=postgresql://cera_local:replace-local-password@127.0.0.1:55432/cera_cms
COMMERCE_DB_HOST=127.0.0.1
COMMERCE_DB_PORT=55432
COMMERCE_DB_NAME=cera_commerce
COMMERCE_DB_USERNAME=cera_local
COMMERCE_DB_PASSWORD=replace-local-password

# Local Valkey
VALKEY_URL=redis://127.0.0.1:6379/0

# Application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CMS_PUBLIC_URL=http://localhost:3001
COMMERCE_API_URL=http://localhost:3002
AUTHENTIK_ISSUER_URL=http://localhost:9000/application/o/cera/

# Replace locally. Production secrets belong only in the deployment secret store.
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECRET=replace-with-at-least-32-random-characters
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=replace-local-admin-password
VENDURE_DISABLE_TELEMETRY=true

# Local mail testing
SMTP_HOST=127.0.0.1
SMTP_PORT=1125
MAILPIT_UI_PORT=8125
MAIL_FROM=CERA Medical <no-reply@local.cera.invalid>

# External integrations: use sandbox/test credentials locally
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
RESEND_API_KEY=
GLITCHTIP_DSN=
